# Default to auto-normalized line endings
* text=auto

# Shell scripts must use LF
*.sh text eol=lf
gradlew text eol=lf

# Windows batch scripts must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code and XML files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.pro text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.apk binary
*.aab binary
