<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.MaterialWidgets">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.clock.ClockAppWidgetReceiver"
            android:exported="true"
            android:label="@string/clock_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.weather.WeatherAppWidgetReceiver"
            android:exported="true"
            android:label="@string/weather_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.music.MusicAppWidgetReceiver"
            android:exported="true"
            android:label="@string/music_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.music.MusicPillAppWidgetReceiver"
            android:exported="true"
            android:label="@string/music_pill_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_pill_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.calendar.CalendarCardAppWidgetReceiver"
            android:exported="true"
            android:label="@string/calendar_card_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_card_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.calendar.CircleClockAppWidgetReceiver"
            android:exported="true"
            android:label="@string/circle_clock_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/circle_clock_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.toggles.WifiToggleAppWidgetReceiver"
            android:exported="true"
            android:label="@string/wifi_toggle_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wifi_toggle_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.toggles.DataToggleAppWidgetReceiver"
            android:exported="true"
            android:label="@string/data_toggle_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/data_toggle_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.toggles.FlashlightToggleAppWidgetReceiver"
            android:exported="true"
            android:label="@string/flashlight_toggle_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/flashlight_toggle_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.toggles.RotateToggleAppWidgetReceiver"
            android:exported="true"
            android:label="@string/rotate_toggle_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rotate_toggle_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.system.BatteryAppWidgetReceiver"
            android:exported="true"
            android:label="@string/battery_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.system.StorageRamAppWidgetReceiver"
            android:exported="true"
            android:label="@string/storage_ram_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/storage_ram_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.toggles.BluetoothToggleAppWidgetReceiver"
            android:exported="true"
            android:label="@string/bluetooth_toggle_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bluetooth_toggle_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.toggles.RingerToggleAppWidgetReceiver"
            android:exported="true"
            android:label="@string/ringer_toggle_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ringer_toggle_widget_info" />
        </receiver>

        <service
            android:name=".widget.music.MediaSessionListenerService"
            android:exported="true"
            android:label="@string/music_widget_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
