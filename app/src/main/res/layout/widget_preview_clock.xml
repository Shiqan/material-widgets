<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_scalloped_cookie"
        android:backgroundTint="@color/widget_preview_primary_container"
        android:gravity="center"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:backgroundTint="@color/widget_preview_tertiary_container"
            android:format12Hour="EEE"
            android:format24Hour="EEE"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textAllCaps="true"
            android:textColor="@color/widget_preview_on_tertiary_container"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:includeFontPadding="false"
            android:textColor="@color/widget_preview_on_primary_container"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:includeFontPadding="false"
            android:textColor="@color/widget_preview_primary"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
