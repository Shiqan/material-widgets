<?xml version="1.0" encoding="utf-8"?>
<TextClock xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_text_clock_month_year"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:format12Hour="MMM yyyy"
    android:format24Hour="MMM yyyy"
    android:includeFontPadding="false"
    android:singleLine="true"
    android:textAllCaps="true"
    android:textColor="@color/widget_preview_primary"
    android:textSize="12sp"
    android:textStyle="bold" />
