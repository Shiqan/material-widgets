<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_pill"
    android:backgroundTint="@color/widget_preview_secondary_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE d"
            android:format24Hour="EEEE d"
            android:singleLine="true"
            android:textColor="@color/widget_preview_on_secondary_container"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="MMM yyyy"
            android:format24Hour="MMM yyyy"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textColor="@color/widget_preview_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_scalloped_badge_12"
        android:backgroundTint="@color/widget_preview_primary_container">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:textColor="@color/widget_preview_on_primary_container"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_scalloped_badge_12"
        android:backgroundTint="@color/widget_preview_tertiary_container">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:textColor="@color/widget_preview_on_tertiary_container"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
