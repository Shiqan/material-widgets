<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="@drawable/bg_widget_pill"
            android:backgroundTint="@color/widget_preview_secondary_container"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/widget_preview_on_secondary_container"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_widget_pill"
            android:backgroundTint="@color/widget_preview_primary_container"
            android:format12Hour="hh mm"
            android:format24Hour="HH mm"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/widget_preview_on_primary_container"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_widget_pill"
            android:backgroundTint="@color/widget_preview_secondary_container"
            android:format12Hour="dd MMMM"
            android:format24Hour="dd MMMM"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/widget_preview_on_secondary_container"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
