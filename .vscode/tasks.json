{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Start Emulator (medium_phone)",
      "type": "shell",
      "command": "android emulator start medium_phone",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Android: Build & Run App on Emulator",
      "type": "shell",
      "command": "android run \"app?\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Android: Launch Emulator + Run App",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Android: Start Emulator (medium_phone)",
        "Android: Build & Run App on Emulator"
      ],
      "problemMatcher": []
    },
    {
      "label": "Gradle: Install & Launch Debug APK",
      "type": "shell",
      "command": "./gradlew installDebug && adb shell am start -n com.example.materialwidgets/.MainActivity",
      "windows": {
        "command": ".\\gradlew.bat installDebug; adb shell am start -n com.example.materialwidgets/.MainActivity"
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Stop Emulator (medium_phone)",
      "type": "shell",
      "command": "android emulator stop medium_phone",
      "problemMatcher": []
    }
  ]
}
